{
  "schemaName": "gdansk_public_transport",
  "enableColumnBasedNullHandling": true,
  "dimensionFieldSpecs": [
    { "name": "vehicleId",      "dataType": "INT"    },
    { "name": "vehicleCode",    "dataType": "STRING" },
    { "name": "vehicleService", "dataType": "STRING" },
    { "name": "routeId",        "dataType": "INT"    },
    { "name": "routeShortName", "dataType": "STRING" },
    { "name": "tripId",         "dataType": "INT"    },
    { "name": "headsign",       "dataType": "STRING" },
    { "name": "direction",      "dataType": "INT"    },
    { "name": "gpsQuality",     "dataType": "INT"    },
    { "name": "dayBucket",      "dataType": "STRING" }
  ],
  "metricFieldSpecs": [
    { "name": "lat",      "dataType": "DOUBLE"  },
    { "name": "lon",      "dataType": "DOUBLE"  },
    { "name": "speed",    "dataType": "FLOAT"   },
    { "name": "delay",    "dataType": "INT"     },
    { "name": "isOnTime", "dataType": "INT"     },
    { "name": "isLate",   "dataType": "INT"     }
  ],
  "dateTimeFieldSpecs": [
    {
      "name": "generatedTransformed",
      "dataType": "TIMESTAMP",
      "format": "1:MILLISECONDS:EPOCH",
      "granularity": "1:SECONDS"
    },
    {
      "name": "scheduledTripStartTimeTransformed",
      "dataType": "TIMESTAMP",
      "format": "1:MILLISECONDS:EPOCH",
      "granularity": "1:SECONDS"
    }
  ]
}