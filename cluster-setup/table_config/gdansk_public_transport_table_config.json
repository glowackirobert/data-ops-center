{
  "tableName": "gdansk_public_transport",
  "tableType": "OFFLINE",
  "segmentsConfig": {
    "timeColumnName": "generatedTransformed",
    "timeType": "MILLISECONDS",
    "replication": "1",
    "segmentPushType": "APPEND",
    "retentionTimeUnit": "DAYS",
    "retentionTimeValue": "365"
  },
  "tenants": {
    "broker": "DefaultTenant",
    "server": "DefaultTenant"
  },
  "tableIndexConfig": {
    "loadMode": "MMAP",
    "enableDefaultStarTree": false,
    "enableDynamicStarTreeCreation": false,
    "aggregateMetrics": false,
    "nullHandlingEnabled": false,
    "columnMajorSegmentBuilderEnabled": true,
    "optimizeDictionary": false,
    "optimizeDictionaryForMetrics": false,
    "noDictionarySizeRatioThreshold": 0.85,
    "rangeIndexVersion": 2,
    "autoGeneratedInvertedIndex": false,
    "createInvertedIndexDuringSegmentGeneration": false
  },
  "ingestionConfig": {
    "transformConfigs": [
      {
        "columnName": "generatedTransformed",
        "transformFunction": "FromDateTime(generated, 'YYYY-MM-dd''T''HH:mm:ss''Z''')"
      },
      {
        "columnName": "scheduledTripStartTimeTransformed",
        "transformFunction": "FromDateTime(scheduledTripStartTime, 'YYYY-MM-dd''T''HH:mm:ss''Z''')"
      }
    ],
    "batchIngestionConfig": {
      "segmentIngestionType": "APPEND",
      "segmentIngestionFrequency": "DAILY"
    }
  },
  "task": {
    "taskTypeConfigsMap": {
      "SegmentGenerationAndPushTask": {
        "inputDirURI": "s3://gdansk-public-transport/",
        "inputFormat": "json",
        "includeFileNamePattern": "glob:**/*.txt",
        "searchRecursively": "true",
        "maxNumConcurrentTasks": "1",
        "push.mode": "tar",
        "outputDirURI": "/tmp/pinot/segments",
        "pinotFSSpecs": "[{\"scheme\":\"s3\",\"className\":\"org.apache.pinot.plugin.filesystem.S3PinotFS\",\"configs\":{\"region\":\"eu-north-1\"}}]"
      }
    }
  },
  "metadata": {
    "customConfigs": {}
  },
  "isDimTable": false
}