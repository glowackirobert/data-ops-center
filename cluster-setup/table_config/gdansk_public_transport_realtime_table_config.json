{
  "tableName": "gdansk_public_transport",
  "tableType": "REALTIME",
  "segmentsConfig": {
    "timeColumnName": "generatedTransformed",
    "timeType": "MILLISECONDS",
    "replicasPerPartition": "1",
    "retentionTimeUnit": "DAYS",
    "retentionTimeValue": "1"
  },
  "tenants": {
    "broker": "DefaultTenant",
    "server": "DefaultTenant"
  },
  "tableIndexConfig": {
    "loadMode": "MMAP",
    "streamConfigs": {
      "streamType": "kafka",
      "stream.kafka.consumer.type": "lowlevel",
      "stream.kafka.topic.name": "gdansk-public-transport",
      "stream.kafka.decoder.class.name": "org.apache.pinot.plugin.inputformat.json.JSONMessageDecoder",
      "stream.kafka.consumer.factory.class.name": "org.apache.pinot.plugin.stream.kafka30.KafkaConsumerFactory",
      "stream.kafka.broker.list": "kafka:9092",
      "realtime.segment.flush.threshold.rows": "500000",
      "realtime.segment.flush.threshold.time": "6h",
      "stream.kafka.consumer.prop.auto.offset.reset": "smallest"
    },
    "enableDefaultStarTree": false,
    "enableDynamicStarTreeCreation": true,
    "aggregateMetrics": false,
    "nullHandlingEnabled": true,
    "columnMajorSegmentBuilderEnabled": true,
    "optimizeDictionary": false,
    "optimizeDictionaryForMetrics": false,
    "noDictionarySizeRatioThreshold": 0.85,
    "rangeIndexVersion": 2,
    "autoGeneratedInvertedIndex": false,
    "createInvertedIndexDuringSegmentGeneration": true,
    "sortedColumn": ["routeShortName"],
    "invertedIndexColumns": ["speed", "vehicleCode", "routeShortName"],
    "rangeIndexColumns": ["delay"],
    "starTreeIndexConfigs": [
      {
        "dimensionsSplitOrder": ["dayBucket", "routeShortName"],
        "skipStarNodeCreationForDimensions": [],
        "functionColumnPairs": ["SUM__isOnTime", "SUM__isLate", "COUNT__*", "AVG__speed"],
        "maxLeafRecords": 10000
      }
    ]
  },
  "ingestionConfig": {
    "transformConfigs": [
      {
        "columnName": "generatedTransformed",
        "transformFunction": "FromDateTime(generated, 'YYYY-MM-dd''T''HH:mm:ss''Z''')"
      },
      {
        "columnName": "scheduledTripStartTimeTransformed",
        "transformFunction": "FromDateTime(scheduledTripStartTime, 'YYYY-MM-dd''T''HH:mm:ss''Z''')"
      },
      {
        "columnName": "dayBucket",
        "transformFunction": "TODATETIME(generatedTransformed, 'yyyy-MM-dd', 'Europe/Warsaw')"
      },
      {
        "columnName": "isOnTime",
        "transformFunction": "CASE WHEN delay BETWEEN -60 AND 60 THEN 1 ELSE 0 END"
      },
      {
        "columnName": "isLate",
        "transformFunction": "CASE WHEN delay > 60 THEN 1 ELSE 0 END"
      }
    ]
  },
  "metadata": {
    "customConfigs": {}
  },
  "isDimTable": false
}
