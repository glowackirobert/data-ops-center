# check=skip=InvalidDefaultArgInFrom
# The ARG deliberately has no default — the version comes from
# cluster-setup/env/versions.env, passed as --build-arg (see README-docker.md)
ARG APACHE_PINOT_VERSION

# Start from the base Pinot image
FROM apachepinot/pinot:${APACHE_PINOT_VERSION}

# Define build-time arguments
ENV OUTPUT_DIR=/opt/pinot/scripts
ENV LOG_DIR=/opt/pinot/logs

# Create directories for schema and table creation scripts, and GC logs
RUN mkdir -p ${OUTPUT_DIR} ${LOG_DIR}

# Copy the scripts into the image
COPY cluster-setup/table_config/* /opt/pinot/scripts/
COPY cluster-setup/pinot/* /opt/pinot/config/

# Fix line endings and make scripts executable
RUN sed -i 's/\r$//' /opt/pinot/scripts/add-tables.sh && \
    chmod +x /opt/pinot/scripts/* && \
    chmod +x /opt/pinot/config/*
