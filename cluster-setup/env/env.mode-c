# Mode C — fully open (temporary), no domain, no tunnel. Lock the EC2
# security group down to your own IP for as long as this is active — see
# README-ec2.md. Replace <PUBLIC_IP_OR_DNS> below with the instance's actual
# public IP/DNS (browser-reachable, not the container name) before starting.
BIND=0.0.0.0
DEBUG_BIND=0.0.0.0

SUPERSET_DOMAIN=http://<PUBLIC_IP_OR_DNS>:8088
WEBAPP_ORIGIN=http://<PUBLIC_IP_OR_DNS>:3001
GRAFANA_ROOT_URL=http://<PUBLIC_IP_OR_DNS>:3000
# Must be false: a Secure-flagged cookie is silently dropped by the browser
# over plain HTTP to a non-localhost origin, which looks like a login that
# never completes.
GRAFANA_COOKIE_SECURE=false
