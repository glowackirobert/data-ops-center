# Single source of truth for Docker image versions.
# Consumed by:
#   - container-compose.yml — pass as the FIRST --env-file on every compose command
#   - the docker build commands in README-docker.md
#   - .github/workflows/docker-ci.yml
# kafka-producer-app is the exception: Maven owns its version in pom.xml.

# Third-party images
ZOOKEEPER_VERSION=3.9.5
KAFKA_VERSION=4.3.1
SCHEMA_REGISTRY_VERSION=8.3.0
PROMETHEUS_VERSION=v3.13.0
GRAFANA_VERSION=13.1.0
LOKI_VERSION=3.7.4
ALLOY_VERSION=v1.18.1
CADDY_VERSION=2.10-alpine
PYTHON_VERSION=3.13-slim

# Custom images
APACHE_PINOT_VERSION=1.5.1
SUPERSET_VERSION=6.1.0
WEB_APP_VERSION=1.0.0