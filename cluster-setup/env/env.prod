DOCKER_IMAGE_BASE_PATH=robertglowacki83/
INGESTION_DATE=
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
BIND=127.0.0.1
SUPERSET_PINOT_URI=pinot://pinot-broker:8099/query/sql?controller=http://pinot-controller:9000
PINOT_CONTROLLER_DATA_DIR=s3://gdansk-public-transport/pinot/deep-store/prod
# Browser-visible origins (what the user's browser can actually reach). They
# are served by Caddy, so they must match BASE_DOMAIN below - on EC2 that means
#   SUPERSET_DOMAIN=https://bi.example.com
#   WEBAPP_ORIGIN=https://map.example.com
# Caddy is the public entrypoint (80/443) and reaches every upstream over the
# Docker network, so the four remaining ${BIND} mappings (web-app 3001,
# Superset 8088, Grafana 3000, Pinot controller 9000) exist only for SSH
# tunnelling and debugging. Leave BIND=127.0.0.1: the security group should
# open 80 and 443 and nothing else, not least because the Pinot controller API
# can drop tables and segments and is only password-protected at the proxy.
SUPERSET_DOMAIN=https://bi.localhost
WEBAPP_ORIGIN=https://map.localhost

# TLS entrypoint (Caddy). On EC2 set BASE_DOMAIN to a domain you own with DNS
# pointing at the instance, and CADDY_TLS to your email address to switch from
# the local CA to Let's Encrypt, e.g.:
#   BASE_DOMAIN=example.com
#   CADDY_TLS=you@example.com
# Let's Encrypt refuses to issue for EC2's own *.compute.amazonaws.com
# hostname, so a real domain is required. Port 80 must be reachable for the
# HTTP-01 challenge; the security group should allow 80 and 443 only.
BASE_DOMAIN=localhost
CADDY_TLS=internal
PINOT_AUTH_USER=admin

# JVM heap sizes — prod: sized for the target instance. Keep each Xmx well
# below the container's share of instance memory (JVM off-heap overhead;
# the Pinot server also maps segments off-heap).
ZOOKEEPER_HEAP_MB=1000
KAFKA_HEAP=-Xms1G -Xmx1G
SCHEMA_REGISTRY_HEAP=-Xmx512M
PINOT_CONTROLLER_HEAP=-Xms256M -Xmx1G
PINOT_BROKER_HEAP=-Xms256M -Xmx1G
PINOT_SERVER_HEAP=-Xms512M -Xmx3G
PINOT_MINION_HEAP=-Xms256M -Xmx2G
PINOT_COMMAND_RUNNER_HEAP=-Xmx512M
PINOT_INGESTION_RUNNER_HEAP=-Xmx6G
INGESTION_JOB_PARALLELISM=8

# Trade producer volume. Costs ~66 bytes of local disk per message (~31 in
# Kafka's log dir + ~35 in Pinot, both under cluster-setup/volumes/), so this
# is really a free-space budget: 1B is ~66 GB and wants a ~100 GB EBS volume.
# Size it to the instance, not to a round number.
TRADE_MESSAGE_COUNT=1000000000
