DOCKER_IMAGE_BASE_PATH=robertglowacki83/

# BIND has no ${BIND:-default} fallback in container-compose.yml, so it must
# always resolve to something; 127.0.0.1 is the safe prod baseline (web
# app/Superset/Grafana reachable only via Caddy or an SSH tunnel — Modes A/B).
# env.mode-c overrides this to 0.0.0.0. DEBUG_BIND, BASE_DOMAIN, CADDY_TLS,
# SUPERSET_DOMAIN, WEBAPP_ORIGIN, GRAFANA_ROOT_URL and GRAFANA_COOKIE_SECURE
# are mode-specific and live in cluster-setup/env/env.mode-{a,b,c} instead —
# pick the one matching how the browser reaches this stack (README-ec2.md)
# and pass it as a third --env-file. Everything below is identical across
# all three modes.
BIND=127.0.0.1

PINOT_AUTH_USER=admin

PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
SUPERSET_PINOT_URI=pinot://pinot-broker:8099/query/sql?controller=http://pinot-controller:9000

PINOT_CONTROLLER_DATA_DIR=s3://gdansk-public-transport/pinot/deep-store/prod
INGESTION_DATE=
INGESTION_JOB_PARALLELISM=8

TRADE_MESSAGE_COUNT=5000000

ZOOKEEPER_HEAP_MB=1000
KAFKA_HEAP=-Xms1G -Xmx1G
SCHEMA_REGISTRY_HEAP=-Xmx512M
PINOT_CONTROLLER_HEAP=-Xms256M -Xmx1G
PINOT_BROKER_HEAP=-Xms256M -Xmx1G
PINOT_SERVER_HEAP=-Xms512M -Xmx3G
PINOT_MINION_HEAP=-Xms256M -Xmx2G
PINOT_COMMAND_RUNNER_HEAP=-Xmx512M
PINOT_INGESTION_RUNNER_HEAP=-Xmx6G
