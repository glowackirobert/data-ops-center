DOCKER_IMAGE_BASE_PATH=robertglowacki83/
APACHE_PINOT_VERSION=1.4.0
INGESTION_DATE=2026/06/01
PROMETHEUS_URL=http://prometheus:9090
BIND=127.0.0.1
SUPERSET_PINOT_URI=pinot://pinot-broker:8099/query/sql?controller=http://pinot-controller:9000
# Browser-visible origins (what the user's browser can actually reach).
# On EC2 set these to the instance's public DNS/IP, e.g.:
#   SUPERSET_DOMAIN=http://ec2-1-2-3-4.eu-central-1.compute.amazonaws.com:8088
#   WEBAPP_ORIGIN=http://ec2-1-2-3-4.eu-central-1.compute.amazonaws.com:3001
# and set BIND=0.0.0.0 + open ports 8088/3001 in the security group.
SUPERSET_DOMAIN=http://localhost:8088
WEBAPP_ORIGIN=http://localhost:3001
