DOCKER_IMAGE_BASE_PATH=
INGESTION_DATE=
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
BIND=0.0.0.0
SUPERSET_PINOT_URI=pinot://pinot-broker:8099/query/sql?controller=http://pinot-controller:9000
PINOT_CONTROLLER_DATA_DIR=s3://gdansk-public-transport/pinot/deep-store/dev
# Browser-visible origins. These go through Caddy (see BASE_DOMAIN below), so
# they are https:// even locally - the Analytics tab iframes Superset, and a
# page served over https cannot embed an http one.
SUPERSET_DOMAIN=https://bi.localhost
WEBAPP_ORIGIN=https://map.localhost

# TLS entrypoint (Caddy). BASE_DOMAIN=localhost needs no DNS and no hosts file:
# browsers resolve any *.localhost name to 127.0.0.1 on their own. CADDY_TLS is
# either "internal" (Caddy's own local CA) or an email address (Let's Encrypt).
BASE_DOMAIN=localhost
CADDY_TLS=internal
PINOT_AUTH_USER=admin

# JVM heap sizes — dev: laptop-friendly. Compose falls back to the prod-sized
# defaults in container-compose.yml when a variable is unset.
ZOOKEEPER_HEAP_MB=256
KAFKA_HEAP=-Xms256M -Xmx512M
SCHEMA_REGISTRY_HEAP=-Xmx256M
PINOT_CONTROLLER_HEAP=-Xms256M -Xmx512M
PINOT_BROKER_HEAP=-Xms256M -Xmx512M
PINOT_SERVER_HEAP=-Xms512M -Xmx1G
PINOT_MINION_HEAP=-Xms256M -Xmx512M
PINOT_COMMAND_RUNNER_HEAP=-Xmx256M
PINOT_INGESTION_RUNNER_HEAP=-Xmx1G
INGESTION_JOB_PARALLELISM=2

# Trade producer volume. Costs ~66 bytes of local disk per message (~31 in
# Kafka's log dir + ~35 in Pinot, both under cluster-setup/volumes/), so this
# is really a free-space budget: 300M is ~20 GB. Check `df` before raising it.
TRADE_MESSAGE_COUNT=300000000
