DOCKER_IMAGE_BASE_PATH=
INGESTION_DATE=
PROMETHEUS_URL=http://host.docker.internal:9090
LOKI_URL=http://host.docker.internal:3100
BIND=0.0.0.0
SUPERSET_PINOT_URI=pinot://pinot-broker:8099/query/sql?controller=http://pinot-controller:9000
PINOT_CONTROLLER_DATA_DIR=s3://gdansk-public-transport/pinot/deep-store/dev
# Browser-visible Superset origin, embedded into the web-app iframe
SUPERSET_DOMAIN=http://localhost:8088

# JVM heap sizes — dev: laptop-friendly. Compose falls back to the prod-sized
# defaults in container-compose.yml when a variable is unset.
ZOOKEEPER_HEAP_MB=256
KAFKA_HEAP=-Xms256M -Xmx512M
SCHEMA_REGISTRY_HEAP=-Xmx256M
PINOT_CONTROLLER_HEAP=-Xms256M -Xmx512M
PINOT_BROKER_HEAP=-Xms256M -Xmx512M
PINOT_SERVER_HEAP=-Xms512M -Xmx1G
PINOT_MINION_HEAP=-Xms256M -Xmx512M
PINOT_COMMAND_RUNNER_HEAP=-Xmx256M
PINOT_INGESTION_RUNNER_HEAP=-Xmx1G
INGESTION_JOB_PARALLELISM=2
