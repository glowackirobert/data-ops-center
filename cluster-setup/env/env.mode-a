# Mode A — Caddy TLS. See "Decide how the browser will reach the stack" in
# README-ec2.md. BIND/DEBUG_BIND are left unset here, inheriting env.prod's
# 127.0.0.1 baseline: Caddy reaches web-app/Superset/Grafana over the
# internal Docker network, and pinot.<domain> reaches pinot-controller the
# same way, so none of the ports this stack publishes need to be reachable
# directly. Requires --profile tls and four DNS A records (map/bi/ops/pinot)
# pointed at the instance — see step 6.

BASE_DOMAIN=example.com
CADDY_TLS=you@example.com
SUPERSET_DOMAIN=https://bi.example.com
WEBAPP_ORIGIN=https://map.example.com
GRAFANA_ROOT_URL=https://ops.example.com
GRAFANA_COOKIE_SECURE=true
