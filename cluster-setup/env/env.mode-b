# Mode B — SSH tunnels, no domain. BIND/DEBUG_BIND are left unset here,
# inheriting env.prod's 127.0.0.1 baseline: nothing is meant to be reachable
# except through an SSH -L tunnel to this instance. Still requires
# -f cluster-setup/container/container-compose.debug-ports.yml so
# pinot-controller's port 9000 is published at all (on loopback) — see the
# tunnel command in step 8.

SUPERSET_DOMAIN=http://localhost:8088
WEBAPP_ORIGIN=http://localhost:3001
GRAFANA_ROOT_URL=http://localhost:3000
# A tunnel lands on localhost, which browsers treat as secure even over
# plain HTTP, so the Secure cookie flag still works here.
GRAFANA_COOKIE_SECURE=true
