    Mirrors pinot-controller-log4j2.xml's two changes (see its comment):
    console is no longer capped at "warn", and file appenders get an explicit
    path under /opt/pinot/logs, which is host-mounted.

-->
<Configuration>
  <Appenders>
    <Console name="console" target="SYSTEM_OUT">
      <PatternLayout>
        <Pattern>%d{yyyy/MM/dd HH:mm:ss.SSS} %p [%c{1}] [%t] %m%n</Pattern>
      </PatternLayout>
    </Console>
    <RandomAccessFile name="serverLog" fileName="/opt/pinot/logs/pinot-server.log" immediateFlush="false">
      <PatternLayout>
        <Pattern>%d{yyyy/MM/dd HH:mm:ss.SSS} %p [%c{1}] [%t] %m%n</Pattern>
      </PatternLayout>
    </RandomAccessFile>
    <RandomAccessFile name="serverErrorLog" fileName="/opt/pinot/logs/pinot-server-error.log" immediateFlush="true">
      <PatternLayout>
        <Pattern>%d{yyyy/MM/dd HH:mm:ss.SSS} %p [%c{1}] [%t] %m%n</Pattern>
      </PatternLayout>
      <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
    </RandomAccessFile>
    <RandomAccessFile name="serverHelixLog" fileName="/opt/pinot/logs/pinot-server-helix.log" immediateFlush="false">
      <PatternLayout>
        <Pattern>%d{yyyy/MM/dd HH:mm:ss.SSS} %p [%c{1}] [%t] %m%n</Pattern>
      </PatternLayout>
    </RandomAccessFile>
  </Appenders>
  <Loggers>
    <Root level="info" additivity="false">
      <AppenderRef ref="console"/>
      <AppenderRef ref="serverLog"/>
      <AppenderRef ref="serverErrorLog"/>
    </Root>
    <Logger name="org.apache.helix" level="info" additivity="false">
      <AppenderRef ref="serverHelixLog"/>
      <AppenderRef ref="serverErrorLog"/>
    </Logger>
    <AsyncLogger name="org.reflections" level="error" additivity="false"/>
  </Loggers>
</Configuration>
