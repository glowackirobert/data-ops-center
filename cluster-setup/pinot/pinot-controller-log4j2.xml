    Adapted from the image's default /opt/pinot/conf/pinot-controller-log4j2.xml.
    Loaded via "-Dlog4j2.configurationFile=/opt/pinot/config/pinot-controller-log4j2.xml"
    (container-compose.yml) instead of relying on Log4j2's default classpath
    lookup. Two changes from the original: the console appender is no longer
    capped at "warn" (Grafana/Loki only sees stdout, so INFO-level operational
    logs never reached it), and every file appender gets an explicit path
    under /opt/pinot/logs, which is host-mounted, instead of an unqualified
    filename that wrote next to the JVM's working directory.

-->
<Configuration>
  <Appenders>
    <Console name="console" target="SYSTEM_OUT">
      <PatternLayout>
        <Pattern>%d{yyyy/MM/dd HH:mm:ss.SSS} %p [%c{1}] [%t] %m%n</Pattern>
      </PatternLayout>
    </Console>
    <RandomAccessFile name="controllerLog" fileName="/opt/pinot/logs/pinot-controller.log" immediateFlush="false">
      <PatternLayout>
        <Pattern>%d{yyyy/MM/dd HH:mm:ss.SSS} %p [%c{1}] [%t] %m%n</Pattern>
      </PatternLayout>
    </RandomAccessFile>
    <RandomAccessFile name="controllerErrorLog" fileName="/opt/pinot/logs/pinot-controller-error.log" immediateFlush="true">
      <PatternLayout>
        <Pattern>%d{yyyy/MM/dd HH:mm:ss.SSS} %p [%c{1}] [%t] %m%n</Pattern>
      </PatternLayout>
      <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
    </RandomAccessFile>
    <RandomAccessFile name="controllerHelixLog" fileName="/opt/pinot/logs/pinot-controller-helix.log" immediateFlush="false">
      <PatternLayout>
        <Pattern>%d{yyyy/MM/dd HH:mm:ss.SSS} %p [%c{1}] [%t] %m%n</Pattern>
      </PatternLayout>
    </RandomAccessFile>
  </Appenders>
  <Loggers>
    <Root level="info" additivity="false">
      <AppenderRef ref="console"/>
      <AppenderRef ref="controllerLog"/>
      <AppenderRef ref="controllerErrorLog"/>
    </Root>
    <!-- Output helix logs to a dedicated file, errors still land in the shared error log -->
    <Logger name="org.apache.helix" level="info" additivity="false">
      <AppenderRef ref="controllerHelixLog"/>
      <AppenderRef ref="controllerErrorLog"/>
    </Logger>
    <AsyncLogger name="org.reflections" level="error" additivity="false"/>
  </Loggers>
</Configuration>
